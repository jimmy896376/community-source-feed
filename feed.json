        {
          "digest": "063696823d547167c1ace991f03c0e281e310211a32c1f4daa03f3fc45e698a6",
          "source_url": "https://down.humoruniv.com/hwiparambbs/data/pds/a_w630079001_ffafc466f23f9e334458e27af0afef43352a0fa9.jpg",
          "mime": "image/jpeg"
        }
      ]
